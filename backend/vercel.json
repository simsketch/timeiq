{
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-booking-payments",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sync-calendars",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/overdue-invoices",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/monthly-invoices",
      "schedule": "0 8 1 * *"
    }
  ]
}
