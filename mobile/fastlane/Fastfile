default_platform(:ios)

# Run from mobile/ after `npx expo prebuild -p ios --clean` (ios/ is generated and gitignored).
# Uses the team's App Store Connect API key, so no Apple ID login is needed, and lets
# xcodebuild create the app and share-extension provisioning profiles itself.
KEY_ID = "3XWAXD7WXH"
ISSUER_ID = "69a6de7e-d8cf-47e3-e053-5b8c7c11a4d1"
KEY_PATH = File.expand_path("~/.private_keys/AuthKey_#{KEY_ID}.p8")
XCODE_AUTH = "-allowProvisioningUpdates -authenticationKeyPath #{KEY_PATH} " \
  "-authenticationKeyID #{KEY_ID} -authenticationKeyIssuerID #{ISSUER_ID}"

platform :ios do
  before_all do
    app_store_connect_api_key(key_id: KEY_ID, issuer_id: ISSUER_ID, key_filepath: KEY_PATH, duration: 1200)
  end

  # The app and its share extension must carry the same build number. The extension
  # reads CURRENT_PROJECT_VERSION from xcargs; prebuild writes a literal "1" into the
  # app's Info.plist, so that one is set directly.
  def build_timeiq
    build_num = Time.now.strftime('%Y%m%d%H%M')
    set_info_plist_value(path: "ios/TimeIQ/Info.plist", key: "CFBundleVersion", value: build_num)
    build_app(
      workspace: "ios/TimeIQ.xcworkspace",
      scheme: "TimeIQ",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "TimeIQ.ipa",
      xcargs: "#{XCODE_AUTH} CURRENT_PROJECT_VERSION=#{build_num}"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build_timeiq
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Upload the listing text in fastlane/metadata (no binary, no screenshots, no submission)"
  lane :metadata do
    upload_to_app_store(app_identifier: "app.timeiq", skip_binary_upload: true, skip_screenshots: true, force: true,
                        submit_for_review: false, precheck_include_in_app_purchases: false)
  end

  desc "Replace the App Store screenshots with fastlane/screenshots (no binary, no submission)"
  lane :screenshots do
    upload_to_app_store(app_identifier: "app.timeiq", skip_binary_upload: true, skip_metadata: true, force: true,
                        overwrite_screenshots: true, submit_for_review: false, precheck_include_in_app_purchases: false)
  end

  desc "Build and upload to App Store Connect (does not submit for review)"
  lane :release do
    build_timeiq
    upload_to_app_store(skip_metadata: true, skip_screenshots: true, submit_for_review: false, precheck_include_in_app_purchases: false)
  end
end
